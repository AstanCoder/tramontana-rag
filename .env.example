# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Infraestructura ---
DATABASE_URL=postgresql+psycopg://tramontana:tramontana@localhost:5432/tramontana
REDIS_URL=redis://localhost:6379/0

# --- Subida de documentos ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25
MAX_PAGES=200

# --- LLM ---
# mock: respuestas deterministas sin red; litellm: Gemini real (requiere GEMINI_API_KEY)
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.5-flash
# Lista separada por comas
LLM_FALLBACK_MODELS=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
LLM_TIMEOUT_S=30
LLM_NUM_RETRIES=2
EMBED_BATCH_SIZE=50
# Sin definir = umbral por proveedor (mock 0.40, litellm 0.62). Descomentar solo para forzar otro valor.
# EVIDENCE_MIN_SIMILARITY=0.62

# --- API ---
# Lista separada por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Observabilidad ---
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# --- Docker Compose (docker compose up --build) ---
# Compose fija DATABASE_URL, REDIS_URL, UPLOAD_DIR y OTEL_* para los contenedores; el resto se lee de este fichero.
# local: trazas a Jaeger (http://localhost:16686); datadog: trazas a Datadog (requiere DD_API_KEY)
OTEL_COLLECTOR_CONFIG=local
DD_API_KEY=
DD_SITE=datadoghq.com
